        "marker": "numbers",
        "items": [
          {
            "group": "Come ti senti",
            "title": "L'ansia arriva anche quando non succede niente di preciso",
            "who": "",
            "body": [
              {
                "kind": "p",
                "text": {
                  "p": [
                    [
                      {
                        "t": "E hai cominciato a evitare situazioni che prima affrontavi."
                      }
                    ]
                  ]
                }
              }
            ],
            "links": [],
            "anchor": ""
          },
          {
            "group": "",
            "title": "Da settimane l'umore resta basso",
            "who": "",
            "body": [
              {
                "kind": "p",
                "text": {
                  "p": [
                    [
                      {
                        "t": "Le cose che ti piacevano non ti dicono più niente."
                      }
                    ]
                  ]
                }
              }
            ],
            "links": [],
            "anchor": ""
          },
          {
            "group": "",
            "title": "Qualcosa che ti è successo torna all'improvviso o di notte",
            "who": "",
