                    ]
                  ]
                }
              }
            ],
            "links": [],
            "anchor": ""
          },
          {
            "group": "Cosa ti trovi a fare",
            "title": "Controllare, contare, ripetere gli stessi gesti",
            "who": "",
            "body": [
              {
                "kind": "p",
                "text": {
                  "p": [
                    [
                      {
                        "t": "Anche se sai che non serve."
